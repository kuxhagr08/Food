# QuickBite Environment Variables Configuration
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-32874
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database: sqlite (local development) or postgres (production)
DB_ENGINE=sqlite
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/food_delivery

# Redis & Channels (leave blank for InMemoryChannelLayer in local dev without Redis)
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Payment Gateways (Razorpay Test Keys)
RAZORPAY_KEY_ID=rzp_test_sampleKey1234
RAZORPAY_KEY_SECRET=rzp_test_secretKey5678

